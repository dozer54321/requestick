# Copy to mesh.env and fill in. start.sh / install.sh can write this for you.
MESH_DOMAIN=requestick.yourcompany.com
POSTGRES_PASSWORD=change-me-long-random
BETTER_AUTH_SECRET=change-me-even-longer-random

# Optional. Leave unset to use the image in this folder (requestick:local).
# After a GitHub Release you can pull instead of building:
# REQUESTICK_IMAGE=ghcr.io/YOURORG/requestick:v1.0.0
