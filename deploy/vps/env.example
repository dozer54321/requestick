# Copy to mesh.env and fill in. start.sh / install.sh can write this for you.
MESH_DOMAIN=requestick.yourcompany.com
POSTGRES_PASSWORD=change-me-long-random
BETTER_AUTH_SECRET=change-me-even-longer-random

# Set by Admin → Updates when you switch versions. Leave unset for the
# image that came with this pack (requestick:local).
# REQUESTICK_IMAGE=requestick:v1.0.3
# REQUESTICK_VERSION=v1.0.3
